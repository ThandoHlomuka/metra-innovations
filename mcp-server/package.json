    "start": "node dist/index.js",
    "dev": "node --watch --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
