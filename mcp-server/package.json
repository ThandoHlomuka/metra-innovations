  "description": "MCP server for Metra Innovations - enables AI agents to query company info, submit contact queries, and contact via WhatsApp",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "metra-mcp": "./dist/index.js"
  },
  "scripts": {
